# Security headers for Cloudflare static assets (no build)
# NOTE: no long immutable caching — filenames aren't content-hashed here,
# so let Cloudflare's default revalidation (ETag + max-age=0) do its job.
/
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

